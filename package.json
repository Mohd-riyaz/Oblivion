{
  "name": "oblivion",
  "version": "1.0.0",
  "description": "OBLIVION — Music Discovery and Streaming Application",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
